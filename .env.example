# ==========================================================================
# Velqor Society – Environment Variables
# Copy this file to ".env.local" and fill in your real values.
# NEVER commit real keys. NEVER expose secret keys to the frontend.
# The placeholders below use <angle-bracket> form on purpose so no secret
# scanner mistakes them for real keys – replace the WHOLE placeholder.
# ==========================================================================

# --- App ------------------------------------------------------------------
# Public base URL of your deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Project URL and anon key are safe for the browser (public).
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service role key – SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# --- Stripe ---------------------------------------------------------------
# Publishable key is safe for the browser. Format: pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# Secret key – SERVER ONLY. Format: sk_test_...
STRIPE_SECRET_KEY=<your-stripe-secret-key>

# Webhook signing secret from `stripe listen` or the Dashboard. Format: whsec_...
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# The Stripe Price ID for "Velqor Society Premium" (recurring, monthly).
STRIPE_PREMIUM_PRICE_ID=<your-stripe-premium-price-id>

# --- Pricing (display only – source of truth is Stripe) -------------------
NEXT_PUBLIC_PREMIUM_PRICE_AMOUNT=19,99
NEXT_PUBLIC_PREMIUM_PRICE_CURRENCY=€
NEXT_PUBLIC_PREMIUM_PRICE_INTERVAL=Monat
